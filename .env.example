# Copy to .env.local and fill in. .env* is gitignored.

# Supabase — server only.
#
# Use a **secret key** (sb_secret_…), not the legacy service_role JWT:
# Dashboard → Project Settings → API Keys → Secret keys → create.
#
# Both bypass RLS via the same Postgres role, but a secret key can be rotated
# and revoked on its own, and Supabase rejects it outright from a browser — so
# a leak into client code fails loudly instead of working. Legacy JWT keys are
# deprecated end of 2026.
#
# Never prefix either with NEXT_PUBLIC_.
SUPABASE_URL=https://wxgwzrlkdajxtplnixfd.supabase.co
SUPABASE_SECRET_KEY=

# Signs the session cookie. At least 32 characters.
#   openssl rand -base64 32
SESSION_SECRET=
